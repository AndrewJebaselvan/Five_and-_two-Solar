# Copy this file to .env and fill in your local values. Never commit .env.
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://solar_user:change_this_password@localhost:3306/five_two_energy_db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-running
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional OpenAI Responses API integration; keep keys server-side only.
# Without AI_API_KEY and AI_MODEL, the chatbot uses its deterministic fallback.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/responses
AI_MODEL=gpt-4.1-mini
